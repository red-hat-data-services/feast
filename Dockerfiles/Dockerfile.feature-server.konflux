# Stage 1: Builder — full image with complete toolchain for compilation
FROM registry.access.redhat.com/ubi9/python-312:1 AS builder

USER 0

# libpq-devel needed for psycopg-c compilation
RUN dnf install -y libpq-devel && dnf clean all

COPY prebuild-power.sh /prebuild-power.sh
RUN chmod +x /prebuild-power.sh

RUN set -e && if [ "$(uname -m)" = "ppc64le" ]; then \
        echo "Power architecture detected. Running prebuild script..." && \
        /prebuild-power.sh && \
        python3 -m pip install /wheelhouse/*.whl && \
        echo "Listing built wheels:" && ls -lh /wheelhouse; \
    else \
        echo "Non-Power architecture detected; skipping Power prebuild"; \
    fi

COPY requirements.txt requirements.txt
# setuptools >=82 removed pkg_resources; grpcio's legacy setup.py (sdist on ppc64le) needs it.
RUN python3 -m pip install 'setuptools<82' wheel && \
    python3 -m pip install -r requirements.txt

# Stage 2: Runtime — minimal image for light and secure footprint
FROM registry.access.redhat.com/ubi9/python-312-minimal:1

USER 0
# Runtime-only native libraries needed by installed pip packages
RUN microdnf install -y libpq && microdnf clean all

# Copy the full Python environment (venv, site-packages, scripts) from builder
COPY --from=builder /opt/app-root /opt/app-root

# modify permissions to support running with a random uid
RUN chmod g+w $(python -c "import feast.ui as ui; print(ui.__path__)" | tr -d "[']")/build/projects-list.json

USER 1001

LABEL com.redhat.component="odh-feature-server" \
      name="odh-feature-server-rhel9" \
      description="odh-feature-server" \
      summary="odh-feature-server" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-feature-server" \
      io.k8s.description="odh-feature-server"
