# Stage 1: Build with full Python 312 image (includes compilers and dev tools)
FROM registry.access.redhat.com/ubi9/python-312:1@sha256:5b184c2acfe9e2eb9df1a243da8e4a82fedd96e5e7f6648ec5512656177fa326 AS builder

USER 0

COPY sdk/python/requirements/py3.12-minimal-requirements.txt /tmp/requirements.txt
# Pinned, hashed requirements (resolved from the Cachi2 cache) and the
# Power (ppc64le) specific requirement files.
COPY sdk/python/feast/infra/feature_servers/multicloud/requirements-ppc64le.txt /tmp/requirements-ppc64le.txt
COPY sdk/python/feast/infra/feature_servers/multicloud/requirements-ppc64le2.txt /tmp/requirements-ppc64le2.txt

# Power (ppc64le) only: install prebuilt ppc64le wheels. Each file declares its
# own --index-url, so install them separately (a single pip run would keep only
# one index). --no-deps is required because the files are hash-pinned.
RUN if [ "$(uname -m)" = "ppc64le" ]; then \
        echo "Power architecture detected. Installing ppc64le-specific packages..."; \
        pip install --no-deps -r /tmp/requirements-ppc64le2.txt && \
        pip install --no-deps -r /tmp/requirements-ppc64le.txt; \
    else \
        echo "Non-Power architecture detected; skipping Power-specific package installation."; \
    fi

# Install the remaining pinned dependencies. On ppc64le, drop every entry
# (including its --hash continuation lines) for packages installed above,
# plus faiss-cpu, which is not installed on Power.
RUN if [ "$(uname -m)" = "ppc64le" ]; then \
        sed -n 's/^\([A-Za-z0-9_.-]*\)==.*/\1/p' /tmp/requirements-ppc64le.txt /tmp/requirements-ppc64le2.txt \
            | tr 'A-Z' 'a-z' > /tmp/ppc64le-packages.txt && \
        echo "faiss-cpu" >> /tmp/ppc64le-packages.txt && \
        awk 'NR==FNR { skip[$1]=1; next } /^[^[:space:]#]/ { split($0, a, "=="); s = (tolower(a[1]) in skip) } !s' \
            /tmp/ppc64le-packages.txt /tmp/requirements.txt > /tmp/requirements-filtered.txt && \
        pip install --no-deps -r /tmp/requirements-filtered.txt; \
    else \
        echo "Non-Power architecture detected"; \
        pip install --no-deps -r /tmp/requirements.txt; \
    fi


# Install feast from local source (dependencies resolve from Cachi2 cache)
COPY sdk/python/feast/infra/feature_servers/multicloud/requirements.txt /tmp/feast-version.txt
COPY pyproject.toml README.md /src/
COPY sdk/python /src/sdk/python
WORKDIR /src
RUN SETUPTOOLS_SCM_PRETEND_VERSION=$(awk -F'==' 'NR==2{gsub(/[[:space:]]/,"",$2); print $2}' /tmp/feast-version.txt) \
    pip install --no-deps '.[minimal]'

# Stage 2: Minimal runtime image (no compilers or dev headers)
FROM registry.access.redhat.com/ubi9/python-312-minimal:9.9@sha256:612eb994cd4255fbafd0de6967efba8d72b62c812058e68e28974458529d0523

USER 0

# Runtime shared libraries required by compiled Python extensions:
#   libicu   - pyarrow (Arrow C++ depends on ICU)
#   libpq    - psycopg[c] (PostgreSQL C adapter)
#   openblas - numpy/faiss-cpu BLAS runtime (do NOT install openblas-devel here;
#              compilers and dev headers belong in the builder stage only)
RUN microdnf install -y git libicu libpq openblas && microdnf clean all

# Copy installed Python packages and entry-point scripts from builder
COPY --from=builder /opt/app-root/lib /opt/app-root/lib
COPY --from=builder /opt/app-root/lib64 /opt/app-root/lib64
COPY --from=builder /opt/app-root/bin /opt/app-root/bin
ENV PATH="/opt/app-root/bin:${PATH}" \
    PYTHONPATH="/opt/app-root/lib64/python3.12/site-packages" \
    LD_LIBRARY_PATH=/opt/app-root/lib64/python3.12/site-packages/re2/lib

RUN echo "/opt/app-root/lib64/python3.12/site-packages/re2/lib" \
    > /etc/ld.so.conf.d/re2.conf && \
    ldconfig

# When building from source, setuptools does not include non-Python data files
# (static assets, UI build, templates, jinja2, sql) because there is no .git
# dir for setuptools-scm to list tracked files.  Copy them from the source tree.
#   static/              - feature server chat UI (importlib_resources)
#   templates/           - feast init project scaffolding (Path / copytree)
#   api/.../templates/   - REST registry Jinja2 codegen (FileSystemLoader)
#   infra/utils/snowflake/ - SQL scripts for Snowflake registry & UDFs (open())
COPY --from=builder /src/sdk/python/feast/static /opt/app-root/lib64/python3.12/site-packages/feast/static
COPY --from=builder /src/sdk/python/feast/templates /opt/app-root/lib64/python3.12/site-packages/feast/templates
COPY --from=builder /src/sdk/python/feast/api/registry/rest/templates /opt/app-root/lib64/python3.12/site-packages/feast/api/registry/rest/templates
COPY --from=builder /src/sdk/python/feast/infra/utils/snowflake /opt/app-root/lib64/python3.12/site-packages/feast/infra/utils/snowflake

# The PyPI wheel ships a pre-built React UI under feast/ui/build/; when
# building from source that directory does not exist.  Create the minimal
# structure the runtime needs (projects-list.json is overwritten at startup).
RUN UI_DIR=$(python -c "import feast.ui as ui; print(ui.__path__)" | tr -d "[']") && \
    mkdir -p "${UI_DIR}/build" && \
    echo '{"projects":[]}' > "${UI_DIR}/build/projects-list.json" && \
    chmod g+w "${UI_DIR}/build/projects-list.json"

# default user
USER 1001

LABEL com.redhat.component="odh-feature-server" \
      name="odh-feature-server-rhel9" \
      description="odh-feature-server" \
      summary="odh-feature-server" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-feature-server" \
      io.k8s.description="odh-feature-server"

