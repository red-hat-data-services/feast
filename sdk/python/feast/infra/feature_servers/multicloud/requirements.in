# Source requirements for feast feature server
# Compiled against the RHAI 3.6 cpu-ubi9 index.
#
# Keep the previous lockfile versions. Pass --upgrade-package feast only,
# so feast 0.67.0 moves and every other pin stays unless 0.67 cannot use it.
# pandas is pinned to 2.2.3 for RHOAIENG-99347.
# Hashes must be the sha256 of that same version on:
#   https://packages.redhat.com/api/pypi/public-rhai/rhoai/3.6/cpu-ubi9/simple/<package>/
#
# To recompile:
# uv pip compile requirements.in \
#   --python-platform linux \
#   --python-version 3.12 \
#   --default-index https://packages.redhat.com/api/pypi/public-rhai/rhoai/3.6/cpu-ubi9/simple/ \
#   --index-strategy first-index \
#   --prerelease=if-necessary \
#   --no-strip-markers \
#   --generate-hashes \
#   --emit-index-url \
#   --upgrade-package feast \
#   --overrides /tmp/rhai-pandas-override.txt \
#   -o requirements-rhai.txt

# feast[minimal] included to prefetch dependencies and RHAI wheel.
# Dockerfile uses --force-reinstall to replace with source build.
# [minimal] extras: aws, gcp, snowflake, redis, go, mysql, postgres-c,
# opentelemetry, grpcio, k8s, duckdb, mcp, milvus
feast[minimal] == 0.67.0

# uvicorn-worker 0.3.0 is the only worker wheel on the 3.6 index, and it
# still calls Config.setup_event_loop. uvicorn 0.36 removed that method.
# 0.34.0 is the version already in the lockfile and the newest 3.6 build
# that worker can start.
uvicorn == 0.34.0

# RHOAIENG-99347: pin pandas 2.2.3 so this image matches the notebook
# image and avoids the NDArrayBacked pickle regression. numpy 2.5.2 and
# pyarrow 20.0.0 stay at the versions already in the lockfile.
numpy == 2.5.2
pandas == 2.2.3
pyarrow == 20.0.0

# Build tools for hermetic `pip install --no-deps --no-build-isolation .`
# setuptools upper bound matches pyproject.toml build-system.requires.
setuptools >= 68.0, < 81
setuptools-scm >= 8.0
wheel >= 0.46.2
